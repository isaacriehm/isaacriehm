# Copy to .env (untracked). In Actions these come from secrets.
# GITHUB_TOKEN: read-only token for the account. Locally, npm scripts fall back to `gh auth token`.
# PROFILE_ORG_TOKENS: optional, one token per other owner (fine-grained tokens have one owner).
# PROFILE_ORG_TOKENS="DevPlusLLC=<token>"
# PROFILE_CONTRIB_TOKEN: optional token for the contributions query (Actions passes its own GITHUB_TOKEN).
# PROFILE_NOW: optional fixed clock (ISO) for reproducible renders.
# label=owner/repo[@branch]; labels: claims, portal, cairn. Omit @branch for the default branch.
PROFILE_SYSTEMS="claims=owner/repo@main;portal=owner/repo;cairn=owner/repo@main"
PROFILE_LOGIN=isaacriehm
PROFILE_ORGS=DevPlusLLC
PROFILE_TZ=America/Phoenix
